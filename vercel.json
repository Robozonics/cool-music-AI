{
  "rewrites": [
    {
      "source": "/api/saavn/:match*",
      "destination": "https://www.jiosaavn.com/:match*"
    },
    {
      "source": "/api/saavncdn/:match*",
      "destination": "https://aac.saavncdn.com/:match*"
    },
    {
      "source": "/api/youtube/:match*",
      "destination": "https://suggestqueries.google.com/:match*"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/saavncdn/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
