{
  "rewrites": [
    {
      "source": "/api/saavn/:match*",
      "destination": "https://www.jiosaavn.com/:match*"
    },
    {
      "source": "/api/youtube/:match*",
      "destination": "https://suggestqueries.google.com/:match*"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
